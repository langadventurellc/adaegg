{
  "name": "adaegg",
  "version": "0.1.0",
  "description": "Creates a self-rewriting hatchling in your own repo.",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "self-rewriting",
    "hatchling",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/langadventurellc/adaegg.git"
  },
  "homepage": "https://github.com/langadventurellc/adaegg#readme",
  "bin": {
    "adaegg": "bin/adaegg.mjs"
  },
  "files": [
    "bin",
    "dist/installer",
    "hatchling",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite hatchling",
    "prepack": "tsc -p installer/tsconfig.build.json",
    "build": "tsc -p hatchling/tsconfig.json && vite build hatchling && tsc -p installer/tsconfig.build.json",
    "lint": "biome check --error-on-warnings . && cd hatchling && ../node_modules/.bin/biome check --error-on-warnings .",
    "format": "biome check --write . && cd hatchling && ../node_modules/.bin/biome check --write .",
    "typecheck": "tsc -p hatchling/tsconfig.json && tsc -p installer/tsconfig.json",
    "test": "vitest run",
    "scan:history": "node scripts/scan-history.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
