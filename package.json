{
  "name": "adaegg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite hatchling",
    "build": "tsc -p hatchling/tsconfig.json && vite build hatchling",
    "lint": "biome check --error-on-warnings . && cd hatchling && ../node_modules/.bin/biome check --error-on-warnings .",
    "format": "biome check --write . && cd hatchling && ../node_modules/.bin/biome check --write .",
    "typecheck": "tsc -p hatchling/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
